MOCK_LLM=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# Alternatives validated by the team contract: llama3.1:8b, qwen2.5:7b-instruct
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=512
LLM_TIMEOUT_SECONDS=60
ROUTER_MAX_ATTEMPTS=2

SQLITE_PATH=./data/runtime/university.db
CHROMA_PATH=./data/runtime/chroma
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SOURCE_REGISTER_PATH=./data/source_register.csv

TOP_K=5
LOG_LEVEL=INFO

